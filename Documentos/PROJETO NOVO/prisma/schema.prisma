generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StatusProcessamento {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum EtapaProcessamento {
  UPLOADING
  QUEUED
  TRANSCRIBING
  ANALYZING
  COMPLETED
  FAILED
}

enum StatusReserva {
  ACTIVE
  RELEASED
  REFUNDED
}

enum TipoTransacao {
  COMPRA
  BLOQUEIO
  ESTORNO
  CONSUMO
}

enum StatusPagamento {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
}

model Wallet {
  id             String   @id @default(cuid())
  userId         String   @unique
  saldoTotal     Float    @default(0)
  saldoBloqueado Float    @default(0)
  updatedAt      DateTime @updatedAt

  processingJobs     ProcessingJob[]
  fileUploads        FileUpload[]
  creditReservations CreditReservation[]
}

model ProcessingJob {
  id                    String              @id @default(cuid())
  userId                String
  fileName              String
  storagePath           String
  fileSizeBytes         Int
  mimeType              String
  estimatedMinutes      Float
  blockedMinutes        Float
  actualMinutesConsumed Float?
  status                StatusProcessamento @default(PENDING)
  currentStage          EtapaProcessamento  @default(UPLOADING)
  retryCount            Int                 @default(0)
  promptId              String?
  transcriptText        String?
  errorMessage          String?
  createdAt             DateTime            @default(now())
  completedAt           DateTime?

  wallet            Wallet            @relation(fields: [userId], references: [userId])
  fileUpload        FileUpload?
  creditReservation CreditReservation?
  segments          TranscriptSegment[]
  speakers          SpeakerProfile[]
  chatMessages      ChatMessage[]
  inconsistencyReports InconsistencyReport[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

model FileUpload {
  id                    String    @id @default(cuid())
  userId                String
  jobId                 String    @unique
  fileName              String
  fileSizeBytes         Int
  mimeType              String
  storagePath           String
  presignedUrlExpiresAt DateTime
  uploadConfirmedAt     DateTime?
  processingStartTime   DateTime?
  processingEndTime     DateTime?
  createdAt             DateTime  @default(now())

  wallet Wallet        @relation(fields: [userId], references: [userId])
  job    ProcessingJob @relation(fields: [jobId], references: [id])

  @@index([userId])
}

model CreditReservation {
  id              String        @id @default(cuid())
  userId          String
  jobId           String        @unique
  reservedMinutes Float
  status          StatusReserva @default(ACTIVE)
  createdAt       DateTime      @default(now())
  releasedAt      DateTime?

  wallet Wallet        @relation(fields: [userId], references: [userId])
  job    ProcessingJob @relation(fields: [jobId], references: [id])

  @@index([userId, status])
}

model LgpdLog {
  id           String   @id @default(cuid())
  userId       String
  action       String
  resourceType String
  resourceId   String
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model TranscriptSegment {
  id            String   @id @default(cuid())
  jobId         String
  sequenceIndex Int
  startMs       Int
  endMs         Int
  speakerId     String?
  originalText  String
  editedText    String?
  lastEditedAt  DateTime?
  wordTimestamps Json
  createdAt     DateTime @default(now())

  job     ProcessingJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  speaker SpeakerProfile? @relation(fields: [speakerId], references: [id])

  @@index([jobId, sequenceIndex])
  @@index([jobId, startMs])
}

model SpeakerProfile {
  id           String   @id @default(cuid())
  jobId        String
  suggestedTag String
  displayName  String
  isRenamed    Boolean  @default(false)
  createdAt    DateTime @default(now())

  job      ProcessingJob      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  segments TranscriptSegment[]

  @@unique([jobId, suggestedTag])
  @@index([jobId])
}

model ChatMessage {
  id              String   @id @default(cuid())
  jobId           String
  userId          String
  role            String
  content         String
  citedSegmentIds String[]
  createdAt       DateTime @default(now())

  job ProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model InconsistencyReport {
  id                   String   @id @default(cuid())
  jobId                String
  description          String
  primarySegmentId     String
  conflictingSegmentId String
  confidenceScore      Float
  createdAt            DateTime @default(now())

  job ProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Transaction {
  id            String        @id @default(cuid())
  userId        String
  type          TipoTransacao
  amountMinutes Float
  refType       String?
  refId         String?
  balanceAfter  Float
  description   String?
  createdAt     DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([refType, refId])
}

model PaymentIntent {
  id                String          @id
  userId            String
  amountCents       Int
  status            StatusPagamento @default(PENDING)
  minutesGranted    Int
  planLabel         String
  checkoutUrl       String
  webhookReceivedAt DateTime?
  webhookAttempts   Int             @default(0)
  createdAt         DateTime        @default(now())
  expiresAt         DateTime

  @@index([userId, status])
  @@index([status, expiresAt])
}

enum TipoPrompt {
  Sistema
  Usuario
}

model PromptFolder {
  id             String         @id @default(cuid())
  userId         String
  name           String
  parentFolderId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  parent         PromptFolder?  @relation("FolderHierarchy", fields: [parentFolderId], references: [id])
  children       PromptFolder[] @relation("FolderHierarchy")
  prompts        PromptTemplate[]

  @@index([userId, parentFolderId])
}

model PromptTemplate {
  id          String       @id @default(cuid())
  userId      String?
  folderId    String?
  name        String
  description String?
  body        String
  type        TipoPrompt   @default(Usuario)
  isDeleted   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  folder      PromptFolder? @relation(fields: [folderId], references: [id])
  applications PromptApplication[]

  @@unique([userId, folderId, name])
  @@index([userId, type, isDeleted])
  @@index([folderId])
}

model PromptApplication {
  id        String         @id @default(cuid())
  fileId    String
  userId    String
  promptId  String
  appliedAt DateTime       @default(now())
  prompt    PromptTemplate @relation(fields: [promptId], references: [id])

  @@index([userId, fileId])
  @@index([promptId])
}

model WebhookAlert {
  id              String   @id @default(cuid())
  paymentIntentId String
  userId          String
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}
