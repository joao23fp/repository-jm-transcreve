{
  "name": "ODARA | 02b - Webhook Resposta Confirmação",
  "nodes": [
    {
      "id": "resp-001",
      "name": "Webhook: Resposta da Paciente",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "confirmacao-resposta",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "resp-002",
      "name": "Extrair Dados da Resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [320, 300],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// O Clint envia o resultado da interação da paciente\n// Esperado: { agendamento_id, resposta: 'confirmado' | 'cancelado', telefone, nome }\nconst body = $input.item.json.body || $input.item.json;\n\nreturn {\n  json: {\n    agendamento_id: body.agendamento_id || body.metadata?.agendamento_id,\n    belle_id:       body.agendamento_belle_id,\n    resposta:       (body.resposta || body.botao_id || '').toLowerCase(),\n    telefone:       body.telefone,\n    nome:           body.nome\n  }\n};"
      }
    },
    {
      "id": "resp-003",
      "name": "Confirmou ou Cancelou?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [540, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond-resp-001",
              "leftValue": "={{ $json.resposta }}",
              "rightValue": "confirmar",
              "operator": { "type": "string", "operation": "contains" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "resp-004",
      "name": "DB: Marcar como Confirmada",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [760, 180],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE agendamentos\nSET confirmacao_resposta = 'confirmado',\n    confirmacao_respondida_em = NOW()\nWHERE id = {{ $json.agendamento_id }}\nRETURNING id, belle_id, nome_cliente, clint_card_id;",
        "options": {}
      },
      "credentials": { "postgres": { "id": "POSTGRES_CREDENTIAL_ID", "name": "PostgreSQL Odara" } }
    },
    {
      "id": "resp-005",
      "name": "🔵 CLINT: Mover Card para Confirmado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 180],
      "parameters": {
        "method": "PUT",
        "url": "https://SEU_DOMINIO_CLINT/api/deals/move",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer SEU_TOKEN_CLINT" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"action\": \"mover_etapa\",\n  \"card_id\": \"{{ $json.clint_card_id }}\",\n  \"nova_etapa\": \"Confirmado\",\n  \"motivo\": \"Paciente confirmou via WhatsApp\"\n}",
        "options": {}
      }
    },
    {
      "id": "resp-006",
      "name": "DB: Marcar como Cancelada",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [760, 420],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE agendamentos\nSET confirmacao_resposta = 'cancelado',\n    confirmacao_respondida_em = NOW(),\n    status = 'Cancelado'\nWHERE id = {{ $json.agendamento_id }}\nRETURNING id, belle_id, nome_cliente, celular_cliente, clint_card_id;",
        "options": {}
      },
      "credentials": { "postgres": { "id": "POSTGRES_CREDENTIAL_ID", "name": "PostgreSQL Odara" } }
    },
    {
      "id": "resp-007",
      "name": "BELLE: Cancelar Agendamento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 360],
      "parameters": {
        "method": "PUT",
        "url": "https://app.bellesoftware.com.br/api/release/controller/IntegracaoExterna/v1.0/agenda/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "669ebde7afafcd939eff35cc43a594cb" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"codConsulta\": {{ $('DB: Marcar como Cancelada').item.json.belle_id }},\n  \"novoStatus\": \"Cancelado\"\n}",
        "options": {}
      }
    },
    {
      "id": "resp-008",
      "name": "🔵 CLINT: Mover Card para Reagendamento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1180, 360],
      "parameters": {
        "method": "PUT",
        "url": "https://SEU_DOMINIO_CLINT/api/deals/move",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer SEU_TOKEN_CLINT" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"action\": \"mover_etapa\",\n  \"card_id\": \"{{ $('DB: Marcar como Cancelada').item.json.clint_card_id }}\",\n  \"nova_etapa\": \"Reagendamento\",\n  \"motivo\": \"Paciente cancelou via WhatsApp\"\n}",
        "options": {}
      }
    },
    {
      "id": "resp-009",
      "name": "🔵 CLINT: Criar Tarefa Reagendamento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1380, 360],
      "parameters": {
        "method": "POST",
        "url": "https://SEU_DOMINIO_CLINT/api/tasks",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer SEU_TOKEN_CLINT" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"action\": \"criar_tarefa\",\n  \"card_id\": \"{{ $('DB: Marcar como Cancelada').item.json.clint_card_id }}\",\n  \"titulo\": \"Reagendar paciente — cancelou via WhatsApp\",\n  \"descricao\": \"{{ $('DB: Marcar como Cancelada').item.json.nome_cliente }} cancelou o agendamento. Entre em contato para remarcar.\",\n  \"responsavel\": \"vendedora\",\n  \"prioridade\": \"alta\"\n}",
        "options": {}
      }
    },
    {
      "id": "resp-010",
      "name": "🔵 CLINT: Enviar MSG Retorno ao Cancelamento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1580, 360],
      "parameters": {
        "method": "POST",
        "url": "https://SEU_DOMINIO_CLINT/api/messages/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer SEU_TOKEN_CLINT" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"action\": \"enviar_mensagem\",\n  \"telefone\": \"{{ $('DB: Marcar como Cancelada').item.json.celular_cliente }}\",\n  \"mensagem\": \"Entendemos que você precisa cancelar, {{ $('DB: Marcar como Cancelada').item.json.nome_cliente }}. 💙\\n\\nUma de nossas especialistas entrará em contato em breve para remarcar em um horário que funcione melhor para você!\"\n}",
        "options": {}
      }
    },
    {
      "id": "resp-011",
      "name": "DB: Tarefa Reagendamento no Banco",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1760, 360],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO tarefas (agendamento_id, tipo, descricao, responsavel, prioridade)\nSELECT {{ $('DB: Marcar como Cancelada').item.json.id }},\n  'reagendamento',\n  'Paciente cancelou via WhatsApp. Remarcar.',\n  'vendedora',\n  'alta';",
        "options": {}
      },
      "credentials": { "postgres": { "id": "POSTGRES_CREDENTIAL_ID", "name": "PostgreSQL Odara" } }
    },
    {
      "id": "resp-012",
      "name": "Resposta OK",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1200, 180],
      "parameters": {}
    }
  ],
  "connections": {
    "Webhook: Resposta da Paciente": {
      "main": [[{ "node": "Extrair Dados da Resposta", "type": "main", "index": 0 }]]
    },
    "Extrair Dados da Resposta": {
      "main": [[{ "node": "Confirmou ou Cancelou?", "type": "main", "index": 0 }]]
    },
    "Confirmou ou Cancelou?": {
      "main": [
        [{ "node": "DB: Marcar como Confirmada", "type": "main", "index": 0 }],
        [{ "node": "DB: Marcar como Cancelada",  "type": "main", "index": 0 }]
      ]
    },
    "DB: Marcar como Confirmada": {
      "main": [[{ "node": "🔵 CLINT: Mover Card para Confirmado", "type": "main", "index": 0 }]]
    },
    "🔵 CLINT: Mover Card para Confirmado": {
      "main": [[{ "node": "Resposta OK", "type": "main", "index": 0 }]]
    },
    "DB: Marcar como Cancelada": {
      "main": [[{ "node": "BELLE: Cancelar Agendamento", "type": "main", "index": 0 }]]
    },
    "BELLE: Cancelar Agendamento": {
      "main": [[{ "node": "🔵 CLINT: Mover Card para Reagendamento", "type": "main", "index": 0 }]]
    },
    "🔵 CLINT: Mover Card para Reagendamento": {
      "main": [[{ "node": "🔵 CLINT: Criar Tarefa Reagendamento", "type": "main", "index": 0 }]]
    },
    "🔵 CLINT: Criar Tarefa Reagendamento": {
      "main": [[{ "node": "🔵 CLINT: Enviar MSG Retorno ao Cancelamento", "type": "main", "index": 0 }]]
    },
    "🔵 CLINT: Enviar MSG Retorno ao Cancelamento": {
      "main": [[{ "node": "DB: Tarefa Reagendamento no Banco", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "notes": "Recebe webhook do Clint com a resposta da paciente. Confirmar → atualiza DB + move card. Cancelar → cancela no Belle + move para Reagendamento + cria tarefa + envia mensagem. URL do webhook: SEU_N8N/webhook/confirmacao-resposta"
}
