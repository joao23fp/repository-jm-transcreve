{
  "id": "M9sg3ZtjI5JxC94h",
  "name": "ODARA | 02b - Webhook Resposta Confirmacao",
  "nodes": [

    {
      "name": "Webhook: Resposta Confirmacao",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [240, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "confirmacao-resposta",
        "responseMode": "onReceived"
      }
    },

    {
      "name": "Code: Extrair Resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nconst resposta = (body.message?.button?.text || body.message?.text || body.data?.text || '').toLowerCase().trim();\nconst meta = body.metadata || body.data?.metadata || {};\nconst agendamento_id = meta.agendamento_id || null;\nconst contact_id = body.contact?.id || body.data?.contact?.id || null;\nif (!agendamento_id) {\n  throw new Error('[02b] agendamento_id nao encontrado: ' + JSON.stringify(body).slice(0, 300));\n}\nreturn { json: { agendamento_id, resposta, contact_id } };"
      }
    },

    {
      "name": "DB: Buscar Agendamento",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [680, 300],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.id, a.clint_card_id, c.nome as nome_cliente FROM agendamentos a LEFT JOIN clientes c ON c.belle_id::text = a.belle_cliente_cod WHERE a.id = $1::uuid LIMIT 1",
        "options": {
          "queryReplacement": "={{ $json.agendamento_id }}"
        }
      }
    },

    {
      "name": "Code: Preparar Dados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const db = $input.item.json;\nconst ext = $('Code: Extrair Resposta').item.json;\nreturn { json: {\n  agendamento_id: db.id,\n  clint_card_id: db.clint_card_id,\n  nome_cliente: db.nome_cliente,\n  resposta: ext.resposta,\n} };"
      }
    },

    {
      "name": "IF: Confirmou?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1100, 300],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.resposta }}",
              "operator": { "type": "string", "operation": "contains" },
              "rightValue": "confirmar"
            }
          ]
        },
        "looseTypeValidation": true
      }
    },

    {
      "name": "CLINT: Mover para Confirmado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1320, 160],
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.clint.digital/v1/deals/{{ $json.clint_card_id }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            { "name": "api-token", "value": "U2FsdGVkX18o3kwB1pZCF/BjjfgN8GgFjmt5Fkzf06JXZIbAkVToB6ZLKPIljW7mSS0ESoxnErXsL9DXE+ZGVg==" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "{\"stage_id\":\"cae200fb-6aad-4e63-8586-4f52f76e06f8\"}",
        "options": {}
      }
    },

    {
      "name": "DB: Marcar Confirmado",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1540, 160],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE agendamentos SET confirmacao_resposta = 'confirmado', confirmacao_respondida_em = NOW(), atualizado_em = NOW() WHERE id = $1::uuid",
        "options": {
          "queryReplacement": "={{ $('Code: Preparar Dados').item.json.agendamento_id }}"
        }
      }
    },

    {
      "name": "CLINT: Mover para Reagendar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1320, 440],
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.clint.digital/v1/deals/{{ $json.clint_card_id }}",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            { "name": "api-token", "value": "U2FsdGVkX18o3kwB1pZCF/BjjfgN8GgFjmt5Fkzf06JXZIbAkVToB6ZLKPIljW7mSS0ESoxnErXsL9DXE+ZGVg==" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "{\"stage_id\":\"455aafb0-8fef-45d6-beb4-41888cc7d18a\"}",
        "options": {}
      }
    },

    {
      "name": "DB: Marcar Cancelado",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1540, 440],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE agendamentos SET confirmacao_resposta = 'cancelado', confirmacao_respondida_em = NOW(), atualizado_em = NOW() WHERE id = $1::uuid",
        "options": {
          "queryReplacement": "={{ $('Code: Preparar Dados').item.json.agendamento_id }}"
        }
      }
    }

  ],
  "connections": {
    "Webhook: Resposta Confirmacao": {
      "main": [[{ "node": "Code: Extrair Resposta", "type": "main", "index": 0 }]]
    },
    "Code: Extrair Resposta": {
      "main": [[{ "node": "DB: Buscar Agendamento", "type": "main", "index": 0 }]]
    },
    "DB: Buscar Agendamento": {
      "main": [[{ "node": "Code: Preparar Dados", "type": "main", "index": 0 }]]
    },
    "Code: Preparar Dados": {
      "main": [[{ "node": "IF: Confirmou?", "type": "main", "index": 0 }]]
    },
    "IF: Confirmou?": {
      "main": [
        [{ "node": "CLINT: Mover para Confirmado", "type": "main", "index": 0 }],
        [{ "node": "CLINT: Mover para Reagendar", "type": "main", "index": 0 }]
      ]
    },
    "CLINT: Mover para Confirmado": {
      "main": [[{ "node": "DB: Marcar Confirmado", "type": "main", "index": 0 }]]
    },
    "CLINT: Mover para Reagendar": {
      "main": [[{ "node": "DB: Marcar Cancelado", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "notes": "Recebe webhook do Clint com resposta da paciente. Confirmar → move card para Confirmado + registra no banco. Cancelar → move card para Reagendar + registra no banco. PENDENTE: trocar credencial Postgres (3 nos) de supabase-afiliadotruppel para PostgreSQL Odara. Registrar URL do webhook no Clint quando acesso restaurado. Ativar somente apos 02a estar enviando mensagens."
}
