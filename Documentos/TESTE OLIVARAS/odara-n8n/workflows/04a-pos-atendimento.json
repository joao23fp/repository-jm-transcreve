{
  "name": "ODARA | 04a - Mensagem Pós-Atendimento (Imediato)",
  "nodes": [
    {
      "id": "pa-001",
      "name": "A cada 5 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [100, 300],
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] }
      }
    },
    {
      "id": "pa-002",
      "name": "DB: Atendimentos Finalizados Sem Pós",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [320, 300],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  a.id, a.belle_id, a.nome_cliente, a.celular_cliente,\n  a.servicos, a.nome_profissional, a.data_hora\nFROM agendamentos a\nWHERE\n  a.status = 'Atendido'\n  AND a.pos_atendimento_enviado = FALSE\n  AND a.data_hora < NOW()\n  AND a.data_hora > NOW() - INTERVAL '24 hours'\nORDER BY a.data_hora ASC;",
        "options": {}
      },
      "credentials": { "postgres": { "id": "POSTGRES_CREDENTIAL_ID", "name": "PostgreSQL Odara" } }
    },
    {
      "id": "pa-003",
      "name": "Há finalizados para notificar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [540, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [{ "id": "cond-pa-001", "leftValue": "={{ $input.all().length }}", "rightValue": 0, "operator": { "type": "number", "operation": "gt" } }],
          "combinator": "and"
        }
      }
    },
    {
      "id": "pa-004",
      "name": "Loop por Atendimento",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [760, 200],
      "parameters": { "batchSize": 1, "options": {} }
    },
    {
      "id": "pa-005",
      "name": "Montar MSG Pós-Procedimento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 200],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const a = $input.item.json;\nlet servicos = [];\ntry { servicos = JSON.parse(a.servicos || '[]'); } catch(e) {}\nconst nomeServico = servicos.map(s => s.nome).join(', ') || 'seu procedimento';\n\n// ⚠️ Personalizar texto por tipo de procedimento\n// Por ora usa texto genérico — substitua por textos específicos por serviço\nconst msgGenerica = `Olá ${a.nome_cliente}! 💆‍♀️\\n\\nFoi um prazer te receber hoje para ${nomeServico}!\\n\\n📋 *Cuidados pós-procedimento:*\\n[INSERIR TEXTO DE CUIDADOS PÓS — específico por procedimento]\\n\\nQualquer dúvida, pode nos chamar! 💙`;\n\nreturn { json: { ...a, mensagem: msgGenerica, nome_servico: nomeServico } };"
      }
    },
    {
      "id": "pa-006",
      "name": "🔵 CLINT: Enviar MSG Cuidados Pós-Procedimento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 200],
      "parameters": {
        "method": "POST",
        "url": "https://SEU_DOMINIO_CLINT/api/messages/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer SEU_TOKEN_CLINT" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"action\": \"enviar_pos_atendimento\",\n  \"telefone\": \"{{ $json.celular_cliente }}\",\n  \"mensagem\": \"{{ $json.mensagem }}\",\n  \"agendamento_id\": {{ $json.id }}\n}",
        "options": {}
      }
    },
    {
      "id": "pa-007",
      "name": "DB: Marcar Pós-Atendimento Enviado",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1380, 200],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE agendamentos SET pos_atendimento_enviado = TRUE, pos_atendimento_enviado_em = NOW() WHERE id = {{ $('Montar MSG Pós-Procedimento').item.json.id }};",
        "options": {}
      },
      "credentials": { "postgres": { "id": "POSTGRES_CREDENTIAL_ID", "name": "PostgreSQL Odara" } }
    },
    { "id": "pa-008", "name": "Nada a enviar", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [760, 420], "parameters": {} }
  ],
  "connections": {
    "A cada 5 minutos": { "main": [[{ "node": "DB: Atendimentos Finalizados Sem Pós", "type": "main", "index": 0 }]] },
    "DB: Atendimentos Finalizados Sem Pós": { "main": [[{ "node": "Há finalizados para notificar?", "type": "main", "index": 0 }]] },
    "Há finalizados para notificar?": { "main": [[{ "node": "Loop por Atendimento", "type": "main", "index": 0 }], [{ "node": "Nada a enviar", "type": "main", "index": 0 }]] },
    "Loop por Atendimento": { "main": [[{ "node": "Montar MSG Pós-Procedimento", "type": "main", "index": 0 }]] },
    "Montar MSG Pós-Procedimento": { "main": [[{ "node": "🔵 CLINT: Enviar MSG Cuidados Pós-Procedimento", "type": "main", "index": 0 }]] },
    "🔵 CLINT: Enviar MSG Cuidados Pós-Procedimento": { "main": [[{ "node": "DB: Marcar Pós-Atendimento Enviado", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
